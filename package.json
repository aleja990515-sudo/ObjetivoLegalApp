{
  "name": "seguimiento-procesos",
  "version": "1.0.0",
  "description": "Seguimiento de procesos de la Rama Judicial de Colombia para una oficina",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run -w apps/api start:prod",
    "dev:api": "npm run -w apps/api start:dev",
    "build:api": "npm run -w apps/api build",
    "start:api": "npm run -w apps/api start:prod",
    "test:api": "npm test -w apps/api",
    "dev:web": "npm run -w apps/web dev",
    "build:web": "npm run -w apps/web build",
    "start:web": "npm run -w apps/web start",
    "lint:web": "npm run -w apps/web lint",
    "typecheck:web": "npm run -w apps/web typecheck",
    "test:web": "npm run -w apps/web test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=26"
  }
}
