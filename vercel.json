{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["gru1"],
  "functions": {
    "api/**/*.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "/api/index?ruta=:ruta*" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 11 * * *" }
  ]
}
